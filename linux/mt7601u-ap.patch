+static int mt7601u_update_ap_beacon(struct mt7601u_dev *dev,
+				    struct ieee80211_vif *vif, u16 interval)
+{
+	int ret;
+
+	ret = mt7601u_mac_ap_write_beacon(dev, vif);
+	mt7601u_mac_ap_beacon_enable(dev, !ret, interval);
+	if (ret)
+		dev_err_ratelimited(dev->dev, "AP beacon update failed: %d\n", ret);
+	return ret;
+}
+
+void mt7601u_ap_beacon_work(struct work_struct *work)
+{
+	struct mt7601u_dev *dev = container_of(work, struct mt7601u_dev,
+					      ap_beacon_work);
+
+	mutex_lock(&dev->mutex);
+	if (dev->ap_vif && dev->ap_beacon_enabled)
+		mt7601u_update_ap_beacon(dev, dev->ap_vif, dev->ap_vif->bss_conf.beacon_int);
+	mutex_unlock(&dev->mutex);
+}
+
+static int mt7601u_set_tim(struct ieee80211_hw *hw, struct ieee80211_sta *sta,
+			   bool set)
+{
+	struct mt7601u_dev *dev = hw->priv;
+
+	/* USB register and MCU transfers may sleep. */
+	ieee80211_queue_work(hw, &dev->ap_beacon_work);
+	return 0;
+}
+
+static int mt7601u_start_ap(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			    struct ieee80211_bss_conf *info)
+{
+	struct mt7601u_dev *dev = hw->priv;
+	int ret;
+
+	if (!info->beacon_int ||
+	    info->beacon_int > FIELD_MAX(MT_BEACON_TIME_CFG_INTVAL) / 16)
+		return -EINVAL;
+
+	mutex_lock(&dev->mutex);
+	ret = mt7601u_mac_ap_write_beacon(dev, vif);
+	if (!ret) {
+		mt7601u_addr_wr(dev, MT_MAC_BSSID_DW0, vif->addr);
+		dev->ap_vif = vif;
+		dev->ap_beacon_enabled = true;
+		mt7601u_mac_ap_beacon_enable(dev, true, info->beacon_int);
+	}
+	mutex_unlock(&dev->mutex);
+	return ret;
+}
+
+static void mt7601u_stop_ap(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			    struct ieee80211_bss_conf *info)
+{
+	struct mt7601u_dev *dev = hw->priv;
+	static const u8 empty_bssid[ETH_ALEN];
+
+	mutex_lock(&dev->mutex);
+	dev->ap_vif = NULL;
+	dev->ap_beacon_enabled = false;
+	mt7601u_mac_ap_beacon_enable(dev, false, 0);
+	mt7601u_addr_wr(dev, MT_MAC_BSSID_DW0, empty_bssid);
+	mutex_unlock(&dev->mutex);
+	cancel_work_sync(&dev->ap_beacon_work);
+}
