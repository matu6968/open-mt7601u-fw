+void mt7601u_mac_ap_beacon_enable(struct mt7601u_dev *dev, bool enable, u16 interval)
+{
+	u32 mask = MT_BEACON_TIME_CFG_INTVAL | MT_BEACON_TIME_CFG_TIMER_EN |
+		   MT_BEACON_TIME_CFG_SYNC_MODE | MT_BEACON_TIME_CFG_TBTT_EN |
+		   MT_BEACON_TIME_CFG_BEACON_TX;
+	u32 value = 0;
+
+	if (enable)
+		value = FIELD_PREP(MT_BEACON_TIME_CFG_INTVAL, (u32)interval << 4) |
+			FIELD_PREP(MT_BEACON_TIME_CFG_SYNC_MODE, 3) |
+			MT_BEACON_TIME_CFG_TIMER_EN | MT_BEACON_TIME_CFG_TBTT_EN |
+			MT_BEACON_TIME_CFG_BEACON_TX;
+	mt76_rmw(dev, MT_BEACON_TIME_CFG, mask, value);
+}
+
+int mt7601u_mac_ap_write_beacon(struct mt7601u_dev *dev, struct ieee80211_vif *vif)
+{
+	struct ieee80211_mutable_offsets offsets = {};
+	struct mt76_txwi *txwi;
+	struct sk_buff *skb;
+	unsigned int i, words;
+	u32 *buffer;
+	int ret;
+
+	skb = ieee80211_beacon_get_template(dev->hw, vif, &offsets, 0);
+	if (!skb)
+		return -ENOMEM;
+
+	/* The beacon table reserves a single 512-byte slot for this AP. */
+	if (skb->len > 512 - sizeof(*txwi)) {
+		ret = -EMSGSIZE;
+		goto free_skb;
+	}
+
+	words = DIV_ROUND_UP(sizeof(*txwi) + skb->len, sizeof(*buffer));
+	buffer = kcalloc(words, sizeof(*buffer), GFP_KERNEL);
+	if (!buffer) {
+		ret = -ENOMEM;
+		goto free_skb;
+	}
+
+	txwi = (void *)buffer;
+	txwi->flags = cpu_to_le16(MT_TXWI_FLAGS_TS);
+	txwi->len_ctl = cpu_to_le16(skb->len);
+	/* All-zero rate and WCID select 1 Mbit/s CCK and group entry zero. */
+	skb_copy_from_linear_data(skb, txwi + 1, skb->len);
+	/* The MAC repeats the template verbatim. Advertise every beacon as a
+	 * DTIM and refresh the unicast traffic bitmap through set_tim().
+	 */
+	if (offsets.tim_length >= 6 && offsets.tim_offset + 6 <= skb->len) {
+		u8 *tim = (u8 *)(txwi + 1) + offsets.tim_offset;
+
+		tim[2] = 0;
+		tim[3] = 1;
+	}
+	for (i = 0; i < words; i++)
+		buffer[i] = le32_to_cpu(((__le32 *)buffer)[i]);
+
+	/* Suppress beacon TX while the MCU updates the multi-command slot. */
+	mt76_clear(dev, MT_BEACON_TIME_CFG, MT_BEACON_TIME_CFG_BEACON_TX);
+	ret = mt7601u_burst_write_regs(dev, MT_BEACON_BASE, buffer, words);
+	kfree(buffer);
+free_skb:
+	dev_kfree_skb(skb);
+	return ret;
+}
