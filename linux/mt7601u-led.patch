+#if IS_REACHABLE(CONFIG_LEDS_CLASS)
+int mt7601u_mcu_set_led(struct mt7601u_dev *dev, unsigned int channel, bool on)
+{
+	__le32 words[] = { cpu_to_le32(channel), cpu_to_le32(on ? 0 : 1) };
+	struct sk_buff *skb = mt7601u_mcu_msg_alloc(words, sizeof(words));
+
+	if (!skb)
+		return -ENOMEM;
+
+	return mt7601u_mcu_msg_send(dev, skb, CMD_LED_MODE_OP, true);
+}
+#endif
