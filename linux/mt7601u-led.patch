+#if IS_REACHABLE(CONFIG_LEDS_CLASS)
+static int led_channel = -1;
+module_param(led_channel, int, 0444);
+MODULE_PARM_DESC(led_channel, "LED hardware channel (0 through 3, -1 disables)");
+
+static int mt7601u_led_brightness(struct led_classdev *led,
+				 enum led_brightness brightness)
+{
+	struct mt7601u_dev *dev = container_of(led, struct mt7601u_dev, led);
+
+	return mt7601u_mcu_set_led(dev, led_channel, brightness != LED_OFF);
+}
+
+static void mt7601u_register_led(struct mt7601u_dev *dev)
+{
+	struct led_classdev *led = &dev->led;
+	int ret;
+
+	if (led_channel == -1)
+		return;
+
+	if (led_channel < 0 || led_channel > 3) {
+		dev_warn(dev->dev, "invalid LED channel %d\n", led_channel);
+		return;
+	}
+
+	led->name = devm_kasprintf(dev->dev, GFP_KERNEL, "%s::wlan",
+				  dev_name(dev->dev));
+	if (!led->name)
+		return;
+
+	led->max_brightness = 1;
+	led->brightness_set_blocking = mt7601u_led_brightness;
+	led->flags = LED_CORE_SUSPENDRESUME;
+	ret = led_classdev_register(dev->dev, led);
+	if (ret)
+		dev_warn(dev->dev, "could not register WLAN LED: %d\n", ret);
+}
+#endif
