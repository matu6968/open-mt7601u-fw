+#ifdef CONFIG_PM
+static void mt7601u_set_wakeup(struct ieee80211_hw *hw, bool enable)
+{
+	struct mt7601u_dev *dev = hw->priv;
+
+	if (dev->wow_supported)
+		device_set_wakeup_enable(&mt7601u_to_usb_dev(dev)->dev, enable);
+}
+
+static int mt7601u_wow_suspend(struct ieee80211_hw *hw,
+			      struct cfg80211_wowlan *wowlan)
+{
+	struct mt7601u_dev *dev = hw->priv;
+	struct ieee80211_vif *vif = dev->wow_vif;
+	int ret;
+
+	if (!wowlan->magic_pkt || !vif || !vif->cfg.assoc ||
+	    !device_may_wakeup(&mt7601u_to_usb_dev(dev)->dev))
+		return 1;
+
+	cancel_delayed_work_sync(&dev->cal_work);
+	cancel_delayed_work_sync(&dev->mac_work);
+	cancel_delayed_work_sync(&dev->freq_cal.work);
+	cancel_delayed_work_sync(&dev->stat_work);
+	ret = mt7601u_mcu_wow(dev, vif);
+	if (ret) {
+		mt7601u_mcu_wow(dev, NULL);
+		/* Fall back to ordinary suspend. Its stop/restart owns the work. */
+		return 1;
+	}
+
+	dev->wow_prepared = true;
+	return 0;
+}
+
+static int mt7601u_wow_resume(struct ieee80211_hw *hw)
+{
+	struct mt7601u_dev *dev = hw->priv;
+	struct cfg80211_wowlan_wakeup wakeup = { .magic_pkt = true,
+					       .pattern_idx = -1 };
+	u32 status;
+
+	if (!dev->wow_prepared)
+		return 0;
+
+	dev->wow_prepared = false;
+	if (dev->wow_reinit) {
+		dev->wow_reinit = false;
+		memset(dev->wcid_mask, 0, sizeof(dev->wcid_mask));
+		memset(dev->wcid, 0, sizeof(dev->wcid));
+		return 1;
+	}
+
+	if (dev->wow_vif && !mt7601u_wow_status(dev, &status) &&
+	    status & MT_WOW_STATUS_MAGIC)
+		ieee80211_report_wowlan_wakeup(dev->wow_vif, &wakeup, GFP_KERNEL);
+	mt7601u_mcu_wow(dev, NULL);
+	ieee80211_queue_delayed_work(hw, &dev->mac_work, MT_CALIBRATE_INTERVAL);
+	ieee80211_queue_delayed_work(hw, &dev->cal_work, MT_CALIBRATE_INTERVAL);
+	if (dev->freq_cal.enabled)
+		ieee80211_queue_delayed_work(hw, &dev->freq_cal.work,
+					     MT_CALIBRATE_INTERVAL);
+	return 0;
+}
+#endif
