diff --git a/drivers/net/wireless/mediatek/mt7601u/mcu.c b/drivers/net/wireless/mediatek/mt7601u/mcu.c
index 1b5cc27..9229beb 100644
--- a/drivers/net/wireless/mediatek/mt7601u/mcu.c
+++ b/drivers/net/wireless/mediatek/mt7601u/mcu.c
@@ -152,6 +152,74 @@ out:
 	return ret;
 }
 
+#ifdef CONFIG_PM
+static int mt7601u_mcu_wow_send(struct mt7601u_dev *dev, enum mcu_cmd cmd,
+			       const void *data, size_t len)
+{
+	struct sk_buff *skb = mt7601u_mcu_msg_alloc(data, len);
+
+	return skb ? mt7601u_mcu_msg_send(dev, skb, cmd, true) : -ENOMEM;
+}
+
+static int mt7601u_mcu_wow_feature(struct mt7601u_dev *dev, u32 feature, u32 value)
+{
+	const __le32 data[] = { cpu_to_le32(feature), cpu_to_le32(value) };
+
+	return mt7601u_mcu_wow_send(dev, CMD_WOW_FEATURE, data, sizeof(data));
+}
+
+int mt7601u_mcu_wow(struct mt7601u_dev *dev, struct ieee80211_vif *vif)
+{
+	const __le32 mask[] = { cpu_to_le32(1), cpu_to_le32(1), cpu_to_le32(1), 0 };
+	struct {
+		__le32 type;
+		u8 station[ETH_ALEN];
+		u8 bssid[ETH_ALEN];
+		__le32 connected;
+	} infra = { .type = cpu_to_le32(3), .connected = cpu_to_le32(1) };
+	u32 status;
+	int ret;
+
+	ret = mt7601u_mcu_wow_feature(dev, 1, !!vif);
+	if (ret || !vif)
+		return ret;
+
+	memcpy(infra.station, vif->addr, ETH_ALEN);
+	memcpy(infra.bssid, vif->bss_conf.bssid, ETH_ALEN);
+	ret = mt7601u_mcu_wow_send(dev, CMD_WOW_CONFIG, mask, sizeof(mask));
+	if (ret)
+		return ret;
+	ret = mt7601u_mcu_wow_send(dev, CMD_WOW_CONFIG, &infra, sizeof(infra));
+	if (ret)
+		return ret;
+
+	ret = mt7601u_mcu_wow_feature(dev, 4, 1);
+	if (ret)
+		return ret;
+	ret = mt7601u_mcu_wow_feature(dev, 3, 1);
+	if (ret)
+		return ret;
+	ret = mt7601u_wow_status(dev, &status);
+	if (ret)
+		return ret;
+	return status & MT_WOW_STATUS_ARMED ? 0 : -EIO;
+}
+
+void mt7601u_mcu_wow_pause(struct mt7601u_dev *dev)
+{
+	usb_kill_urb(dev->mcu.resp.urb);
+}
+
+int mt7601u_mcu_wow_resume(struct mt7601u_dev *dev)
+{
+	reinit_completion(&dev->mcu.resp_cmpl);
+	return mt7601u_usb_submit_buf(dev, USB_DIR_IN, MT_EP_IN_CMD_RESP,
+				      &dev->mcu.resp, GFP_KERNEL,
+				      mt7601u_complete_urb,
+				      &dev->mcu.resp_cmpl);
+}
+#endif
