index c41ae25..919fe1e 100644
--- a/drivers/net/wireless/mediatek/mt7601u/usb.c
+++ b/drivers/net/wireless/mediatek/mt7601u/usb.c
@@ -11,6 +11,60 @@
 #include "usb.h"
 #include "trace.h"
 
+#ifdef CONFIG_PM
+static bool wowlan;
+module_param(wowlan, bool, 0444);
+MODULE_PARM_DESC(wowlan, "Enable experimental wake on a station magic packet");
+
+static const struct wiphy_wowlan_support mt7601u_wowlan = {
+	.flags = WIPHY_WOWLAN_MAGIC_PKT,
+};
+
+int mt7601u_wow_status(struct mt7601u_dev *dev, u32 *status)
+{
+	struct usb_device *udev = mt7601u_to_usb_dev(dev);
+	__le32 value;
+	int ret;
+
+	ret = usb_control_msg_recv(udev, 0, 0x2f,
+				   USB_DIR_IN | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+				   0, 0, &value, sizeof(value), 500, GFP_KERNEL);
+	if (ret)
+		return ret;
+
+	*status = le32_to_cpu(value);
+	return (*status & ~3U) == 0x574f5700 ? 0 : -EOPNOTSUPP;
+}
+
+static void mt7601u_wow_probe(struct mt7601u_dev *dev)
+{
+	struct usb_device *udev = mt7601u_to_usb_dev(dev);
+	u32 status;
+
+	if (!wowlan || mt7601u_wow_status(dev, &status))
+		return;
+
+	/* BootROM enumeration may have omitted bmAttributes remote wake.
+	 * The opted-in driver enables it only for the native WoW firmware. */
+	dev->wow_was_capable = device_can_wakeup(&udev->dev);
+	dev->wow_was_enabled = device_may_wakeup(&udev->dev);
+	device_set_wakeup_capable(&udev->dev, true);
+	dev->hw->wiphy->wowlan = &mt7601u_wowlan;
+	dev->wow_supported = true;
+}
+
+static void mt7601u_wow_remove(struct mt7601u_dev *dev)
+{
+	struct usb_device *udev = mt7601u_to_usb_dev(dev);
+
+	if (!dev->wow_supported)
+		return;
+
+	device_set_wakeup_enable(&udev->dev, dev->wow_was_enabled);
+	device_set_wakeup_capable(&udev->dev, dev->wow_was_capable);
+}
+#endif
