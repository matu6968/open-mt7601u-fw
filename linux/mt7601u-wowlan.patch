 	return 0;
 }
 
+#ifdef CONFIG_PM
+int mt7601u_wow_dma_pause(struct mt7601u_dev *dev)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(250);
+	struct mt7601u_rx_queue *rx = &dev->rx_q;
+	int i;
+
+	for (i = 0; i < __MT_EP_OUT_MAX; i++) {
+		while (READ_ONCE(dev->tx_q[i].used)) {
+			if (time_after_eq(jiffies, deadline))
+				return -EBUSY;
+			usleep_range(1000, 2000);
+		}
+	}
+	mt7601u_kill_rx(dev);
+	tasklet_kill(&dev->rx_tasklet);
+	rx->start = rx->end = rx->pending = 0;
+	return 0;
+}
+
+int mt7601u_wow_dma_resume(struct mt7601u_dev *dev)
+{
+	int i;
+
+	for (i = 0; i < dev->rx_q.entries; i++)
+		usb_unpoison_urb(dev->rx_q.e[i].urb);
+	return mt7601u_submit_rx(dev);
+}
+#endif
